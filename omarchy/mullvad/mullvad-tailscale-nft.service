[Unit]
Description=Allow Tailscale CGNAT (100.64.0.0/10) to bypass Mullvad VPN firewall
After=network-online.target nftables.service mullvad-daemon.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nft -f /etc/nftables.d/mullvad-tailscale.nft
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
